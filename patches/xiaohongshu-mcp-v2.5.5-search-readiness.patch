+// Supports both reactive wrappers used by the site, and direct arrays. An
+// initially empty store is not evidence that the asynchronous search finished.
+const searchFeedsReadyJS = `() => {
+	const f = window.__INITIAL_STATE__?.search?.feeds;
+	const v = Array.isArray(f) ? f : f?.value ?? f?._value;
+	return Array.isArray(v) && v.length > 0;
+}`
+
+const searchFeedsJSON = `() => {
+	const f = window.__INITIAL_STATE__?.search?.feeds;
+	const v = Array.isArray(f) ? f : f?.value ?? f?._value;
+	return Array.isArray(v) ? JSON.stringify(v) : "";
+}`
+
+func waitSearchFeedsReady(page *rod.Page) error {
+	return page.Wait(rod.Eval(searchFeedsReadyJS))
+}
