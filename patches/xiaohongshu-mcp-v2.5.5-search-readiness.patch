+package xiaohongshu
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/go-rod/rod"
+	"github.com/go-rod/rod/lib/launcher"
+)
+
+// Local fixtures only. Do not use the application's browser helper: it loads
+// the real account's cookies. An explicit already-installed browser is required.
+func readinessPage(t *testing.T, document string) *rod.Page {
+	t.Helper()
+	binary := os.Getenv("XHS_TEST_BROWSER_BIN")
+	if binary == "" {
+		t.Skip("set XHS_TEST_BROWSER_BIN to an already installed browser for offline readiness tests")
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "text/html")
+		_, _ = w.Write([]byte(document))
+	}))
+	t.Cleanup(server.Close)
+	launch := launcher.New().Bin(binary).Headless(true)
+	url, err := launch.Launch()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(launch.Cleanup)
+	browser := rod.New().ControlURL(url)
+	if err := browser.Connect(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = browser.Close() })
+	page := browser.MustPage(server.URL)
+	return page
+}
+
+func TestSearchReadinessDoesNotRequireStableDOM(t *testing.T) {
+	page := readinessPage(t, `<!doctype html><body><div id="counter"></div><script>
+		window.__INITIAL_STATE__ = {search: {feeds: {value: []}}};
+		setInterval(() => document.getElementById("counter").textContent = String(Date.now()), 10);
+		setTimeout(() => window.__INITIAL_STATE__.search.feeds.value = [{id:"fixture", noteCard:{title:"fixture"}}], 150);
+	</script>`)
+	if err := waitSearchFeedsReady(page.Timeout(3 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	value, err := page.Eval(searchFeedsJSON)
+	if err != nil || value.Value.Str() == "" {
+		t.Fatalf("ready data must remain extractable: %v", err)
+	}
+}
+
+func TestSearchReadinessSupportsReactiveWrappersAndDirectArray(t *testing.T) {
+	for _, expression := range []string{
+		`{value:[{id:"fixture"}]}`,
+		`{_value:[{id:"fixture"}]}`,
+		`[{id:"fixture"}]`,
+	} {
+		t.Run(expression, func(t *testing.T) {
+			page := readinessPage(t, "<script>window.__INITIAL_STATE__={search:{feeds:"+expression+"}};</script>")
+			if err := waitSearchFeedsReady(page.Timeout(3 * time.Second)); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestSearchReadinessEmptyOrMissingDataRemainsBounded(t *testing.T) {
+	for _, expression := range []string{`undefined`, `{search:{feeds:{value:[]}}}`} {
+		t.Run(expression, func(t *testing.T) {
+			page := readinessPage(t, "<script>window.__INITIAL_STATE__="+expression+";</script>")
+			err := waitSearchFeedsReady(page.Timeout(200 * time.Millisecond))
+			if !errors.Is(err, context.DeadlineExceeded) {
+				t.Fatalf("missing/empty data must not be mistaken for ready: %v", err)
+			}
+		})
+	}
+}
+
+func TestSearchReadinessHonorsCallerCancellation(t *testing.T) {
+	page := readinessPage(t, "<script>window.__INITIAL_STATE__={search:{feeds:{value:[]}}};</script>")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err := waitSearchFeedsReady(page.Context(ctx).Timeout(3 * time.Second))
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("caller cancellation must remain authoritative: %v", err)
+	}
+}
