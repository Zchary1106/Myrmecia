# Agent Factory — Environment Variables
# Copy this file to .env and fill in values

# ============ Core ============
PORT=3000
NODE_ENV=development

# ============ Database ============
# SQLite (development) — no config needed, uses ./data/agent-factory.db
# PostgreSQL (production):
# DATABASE_URL=postgres://user:password@localhost:5432/agent_factory
DB_PATH=

# ============ Redis (optional — enables distributed features) ============
# REDIS_URL=redis://localhost:6379

# ============ Execution ============
# EXECUTOR_MODE=local|docker (default: local)
EXECUTOR_MODE=local
# AGENT_DOCKER_IMAGE=agent-factory/sandbox:latest
# CONTAINER_POOL_SIZE=3

# ============ Worker Mode ============
# WORKER_MODE=scheduler|worker|both (default: both)
WORKER_MODE=both

# ============ Authentication ============
# AUTH_MODE=local|oidc (default: local — no auth required)
AUTH_MODE=local
# SESSION_SECRET=change-me-in-production
# API_AUTH_TOKEN=optional-static-token-for-dev

# OIDC (when AUTH_MODE=oidc)
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# ============ CORS ============
# Comma-separated origins (leave empty for permissive in dev)
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# ============ Secrets Management ============
# SECRET_PROVIDER=env|vault|aws (default: env)
SECRET_PROVIDER=env
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
# AWS_REGION=us-east-1
# AWS_SECRET_PREFIX=agent-factory/

# ============ Myrmecia Model Runtime ============
# New MYRMECIA_* names are preferred; legacy AGENT_FACTORY_* still work as fallbacks.
# MYRMECIA_BASE_URL=https://your-model-endpoint.example.com/v1
# MYRMECIA_API_KEY=
# MYRMECIA_MODEL=gpt-5.4-mini
# AGENT_FACTORY_BASE_URL=https://your-model-endpoint.example.com/v1   # legacy alias
# AGENT_FACTORY_API_KEY=                                                       # legacy alias
# AGENT_FACTORY_MODEL=gpt-5.4-mini                                             # legacy alias
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ============ Browser Query tool (browser-use) ============
# Optional: lets the `browser.query` tool drive a real headless browser on a
# remote browser-use service. Without a token the tool returns a clear error.
# BROWSER_QUERY_URL=https://your-browser-service.example.com/query
# BROWSER_QUERY_TOKEN=

# ============ Agent runtime budgets ============
# These are global ceilings: an agent's own model policy in agents/registry.yaml
# can only lower them, never raise them (see resolveAgentRuntimeLimits()).
# Long-running content pipelines (real MCP research + long-form drafting) usually
# need more than the 300s default wall clock.
# AGENT_MAX_WALL_CLOCK_MS=900000
# AGENT_MAX_EXECUTION_TOKENS=200000
# AGENT_MAX_RESPONSE_TOKENS=8192

# ============ MCP Tool Servers ============
# JSON array of MCP servers to connect over stdio at startup. Their tools are
# aggregated as mcp__<server>__<tool> and surfaced only to agents that explicitly
# include the qualified tool name in allowed_tools (toggle all MCP tools with
# MCP_TOOLS_IN_AGENTS=false).
# This client only speaks stdio — remote HTTP/SSE-only MCP servers (e.g. the
# xiaohongshu-mcp project, which serves Streamable HTTP on :18060) need a
# stdio bridge such as `mcp-remote` (https://www.npmjs.com/package/mcp-remote).
# Example wiring a Xiaohongshu + Douyin content-publishing workflow
# (adjust paths for your machine):
# MCP_SERVERS=[{"name":"xiaohongshu","command":"npx","args":["-y","mcp-remote","http://localhost:18060/mcp"]},{"name":"douyin-search","command":"/path/to/uv","args":["--directory","/path/to/douyin-mcp-search","run","main.py"],"env":{"FASTMCP_CHECK_FOR_UPDATES":"off"}},{"name":"douyin-upload","command":"node","args":["/path/to/douyin-mcp-server/mcp-server/dist/mcp-server/index.js"]}]
# MCP_TOOLS_IN_AGENTS=true

# Built-in WeChat Official Account MCP. Desktop users should configure this in
# Settings instead. WECHAT_MCP_SECRET_KEY is required so the MCP's SQLite store
# never persists AppSecret in plaintext.
# WECHAT_OFFICIAL_ACCOUNT_APP_ID=wx1234567890abcdef
# WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=0123456789abcdef0123456789abcdef
# WECHAT_MCP_SECRET_KEY=replace-with-a-long-random-secret
# WECHAT_MCP_DB_PATH=/absolute/path/to/wechat-mcp.db

# ============ Observability ============
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=agent-factory
LOG_LEVEL=debug

# ============ Vector/RAG ============
# VECTOR_BACKEND=memory|pgvector|qdrant (default: memory)
VECTOR_BACKEND=memory
# EMBEDDING_MODEL=text-embedding-3-small
# QDRANT_URL=http://localhost:6333
